# Demo mode works without credentials. Copy this file to .env to enable AI.
AI_API_KEY=
# API base URL ending in /v1, without /chat/completions
AI_BASE_URL=https://api.openai.com/v1
# Choose a model supported by your provider.
AI_MODEL=
PORT=3000
# Bind to 127.0.0.1 for local use. Use 0.0.0.0 only on a trusted host.
HOST=127.0.0.1
