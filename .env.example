# Demo mode works without credentials. Copy this file to .env to enable AI.
AI_API_KEY=
# API base URL ending in /v1, without /chat/completions
AI_BASE_URL=https://api.openai.com/v1
# Choose a model supported by your provider.
AI_MODEL=

# Optional site profiles. Keys are read only on the server and never returned
# by /api/ai/config. Leave a base URL or model empty to use the provider
# default shown by the app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-sonnet-5
QWEN_API_KEY=
# Copy the current workspace/region endpoint from your Qwen console. This
# Beijing-compatible endpoint is an example and may not fit every account.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

PORT=3000
# Bind to 127.0.0.1 for local use. Use 0.0.0.0 only on a trusted host.
HOST=127.0.0.1
